<!-- =========================================
     HOW WE WORK (Fixed Native Alpine.js)
========================================== -->
<section class="py-24 bg-white dark:bg-slate-950" 
         x-data="{ shown: false }" 
         x-init="let observer = new IntersectionObserver(entries => { if (entries[0].isIntersecting) shown = true; }, { threshold: 0.2 }); observer.observe($el);">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-16">Our Proven Process</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
      
      {% set steps = ["Site Audit & Specs", "System Architecture", "Turnkey Deployment", "Monthly SLA & Support"] %}
      {% for step in steps %}
      <div class="relative transition-all duration-700 ease-out transform"
           :class="shown ? 'translate-y-0 opacity-100' : 'translate-y-12 opacity-0'" 
           style="transition-delay: {{ loop.index0 * 150 }}ms;">
        <div class="w-16 h-16 mx-auto bg-amber-500 text-slate-900 font-bold text-2xl rounded-full flex items-center justify-center mb-6 shadow-md ring-8 ring-slate-50 dark:ring-slate-900">
          {{ loop.index }}
        </div>
        <h3 class="font-bold text-lg text-slate-900 dark:text-white">{{ step }}</h3>
        <!-- Optional connecting line for desktop -->
        {% if not loop.last %}
        <div class="hidden md:block absolute top-8 left-[60%] w-full h-[2px] bg-slate-200 dark:bg-slate-800 -z-10"></div>
        {% endif %}
      </div>
      {% endfor %}

    </div>
  </div>
</section>
