<!DOCTYPE html>
<html
  lang="en"
  x-data="{
    dark: localStorage.getItem('theme') === 'dark'
      || !localStorage.getItem('theme')
  }"
  :class="{ 'dark': dark }"
>

<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Ages Xpat Technologies — CCTV installation, IT systems supply, web design and development, and corporate technology training."
  >
  
  <title>
    {{ title or "Ages Xpat Technologies | Secure. Supply. Build. Train." }}
  </title>


  <!-- =====================================================
       FONT
  ====================================================== -->

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  >


  <!-- =====================================================
       TAILWIND OUTPUT
  ====================================================== -->

  <link
    rel="stylesheet"
    href="/output.css"
  >
  
   <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" ></script>

  <!-- =====================================================
       PREVENT DARK-MODE FLASH
  ====================================================== -->

  <script>
    (() => {
      const theme = localStorage.getItem("theme");

      const dark =
        theme === "dark" ||
        !theme;

      document.documentElement.classList.toggle(
        "dark",
        dark
      );
    })();
  </script>


  <!-- =====================================================
       ALPINEJS
  ====================================================== -->

  <script
    defer
    src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
  ></script>

</head>


<body
  x-data="themeHandler()"
  class="
    min-h-screen
    bg-brand-light
    text-brand-dark
    antialiased
    transition-colors
    duration-300
   selection:bg-amber-500
   selection:text-white
    dark:bg-brand-dark
    dark:text-brand-lavender
  "
>

   <div id="progressBar"
        class="fixed left-0 top-0 z-[9999] h-1 bg-green-600 dark:bg-green-400 transition-colors duration-200"
        style="width:0%">
    </div>

  <!-- =====================================================
       NAVBAR
  ====================================================== -->

{% include "src/components/header.njk" %}




  <!-- =====================================================
       PAGE CONTENT
  ====================================================== -->

  <main>
    {{ content | safe }}
  </main>


  <!-- =====================================================
       FOOTER
  ====================================================== -->

{% include "src/components/footer.njk" %}   
<!-- =========================================
     SCROLL TO TOP BUTTON
========================================== -->
<div x-data="{ showScrollButton: false }"
     @scroll.window="showScrollButton = window.pageYOffset > 400"
     class="fixed bottom-8 right-8 z-50">
  
  <button x-show="showScrollButton"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 translate-y-8"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-8"
          @click="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="group flex h-12 w-12 items-center justify-center rounded-full bg-amber-500 text-slate-900 shadow-lg shadow-amber-500/30 transition-all hover:bg-amber-400 hover:shadow-amber-500/50 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:focus:ring-offset-slate-950"
          aria-label="Scroll to top">
    
    <!-- Animated Arrow Icon -->
    <svg class="h-6 w-6 transition-transform duration-300 group-hover:-translate-y-1.5 group-active:translate-y-0 group-hover:scale-110" 
         fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
    </svg>
    
  </button>
</div>


</body>

</html>
