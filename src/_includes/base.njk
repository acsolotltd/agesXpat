<!DOCTYPE html>
<html
  lang="en"
  x-data="{
    dark: localStorage.getItem('theme') === 'dark'
      || !localStorage.getItem('theme')
  }"
  :class="{ 'dark': dark }"
>

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Ages Xpat Technologies — CCTV installation, IT systems supply, web design and development, and corporate technology training."
  >
  
  <title>
    {{ title or "Ages Xpat Technologies | Secure. Supply. Build. Train." }}
  </title>


  <!-- =====================================================
       FONT
  ====================================================== -->

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  >


  <!-- =====================================================
       TAILWIND OUTPUT
  ====================================================== -->

  <link
    rel="stylesheet"
    href="/output.css"
  >
  
   <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" ></script>

  <!-- =====================================================
       PREVENT DARK-MODE FLASH
  ====================================================== -->

  <script>
    (() => {
      const theme = localStorage.getItem("theme");

      const dark =
        theme === "dark" ||
        !theme;

      document.documentElement.classList.toggle(
        "dark",
        dark
      );
    })();
  </script>


  <!-- =====================================================
       ALPINEJS
  ====================================================== -->

  <script
    defer
    src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
  ></script>

</head>


<body
  x-data="themeHandler()"
  class="
    min-h-screen
    bg-brand-light
    text-brand-dark
    antialiased
    transition-colors
    duration-300
   selection:bg-amber-500
   selection:text-white
    dark:bg-brand-dark
    dark:text-brand-lavender
  "
>

  <!-- =====================================================
       NAVBAR
  ====================================================== -->

{% include "src/components/header.njk" %}




  <!-- =====================================================
       PAGE CONTENT
  ====================================================== -->

  <main>
    {{ content | safe }}
  </main>


  <!-- =====================================================
       FOOTER
  ====================================================== -->

{% include "src/components/footer.njk" %}   


