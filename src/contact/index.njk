---
layout: "base.njk"
title: "About Ages Xpat Technologies | Contact Us"
description: "Since 2009, Ages Xpat Technologies has"
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800 p-6 sm:p-10 transition-colors duration-300">
    
    <!-- Form Header -->
    <div class="mb-10 text-center sm:text-left">
      <span class="text-xs sm:text-sm font-bold text-amber-500 tracking-widest uppercase mb-2 block">Get in Touch</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Let’s Build or Secure Your Infrastructure
      </h2>
      <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Select your inquiry type and services below. Our technical team will review your request and get back to you within 24 hours.
      </p>
    </div>

    <form action="#" method="POST" class="space-y-8" id="contact-form">
      
      <!-- 1. Select Purpose / Inquiry Type -->
      <div>
        <label class="block text-sm font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider mb-4">
          1. What is the main objective of this inquiry? <span class="text-amber-500">*</span>
        </label>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          
          <!-- Option A: Consult an Expert -->
          <label class="relative flex flex-col p-4 cursor-pointer rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 hover:border-amber-500/50 dark:hover:border-amber-500/50 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/5 dark:has-[:checked]:bg-amber-500/10 transition-all">
            <input type="radio" name="inquiry_type" value="consult_expert" class="sr-only" checked />
            <span class="flex items-center justify-between mb-2">
              <svg class="w-6 h-6 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
              <span class="w-4 h-4 rounded-full border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 flex items-center justify-center text-white peer-checked:border-amber-500">
                <span class="w-2 h-2 rounded-full bg-amber-500 opacity-0 [label:has(:checked)_&]:opacity-100"></span>
              </span>
            </span>
            <span class="text-sm font-bold text-slate-900 dark:text-white">Consult an Expert</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">Technical advice & roadmap</span>
          </label>

          <!-- Option B: Request an Audit -->
          <label class="relative flex flex-col p-4 cursor-pointer rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 hover:border-amber-500/50 dark:hover:border-amber-500/50 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/5 dark:has-[:checked]:bg-amber-500/10 transition-all">
            <input type="radio" name="inquiry_type" value="request_audit" class="sr-only" />
            <span class="flex items-center justify-between mb-2">
              <svg class="w-6 h-6 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span class="w-4 h-4 rounded-full border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 flex items-center justify-center text-white">
                <span class="w-2 h-2 rounded-full bg-amber-500 opacity-0 [label:has(:checked)_&]:opacity-100"></span>
              </span>
            </span>
            <span class="text-sm font-bold text-slate-900 dark:text-white">Request an Audit</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">Site or system assessment</span>
          </label>

          <!-- Option C: Project Implementation -->
          <label class="relative flex flex-col p-4 cursor-pointer rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 hover:border-amber-500/50 dark:hover:border-amber-500/50 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/5 dark:has-[:checked]:bg-amber-500/10 transition-all">
            <input type="radio" name="inquiry_type" value="project_implementation" class="sr-only" />
            <span class="flex items-center justify-between mb-2">
              <svg class="w-6 h-6 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
              <span class="w-4 h-4 rounded-full border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 flex items-center justify-center text-white">
                <span class="w-2 h-2 rounded-full bg-amber-500 opacity-0 [label:has(:checked)_&]:opacity-100"></span>
              </span>
            </span>
            <span class="text-sm font-bold text-slate-900 dark:text-white">Project Quote</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">Turnkey deployment</span>
          </label>

          <!-- Option D: Support / General -->
          <label class="relative flex flex-col p-4 cursor-pointer rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 hover:border-amber-500/50 dark:hover:border-amber-500/50 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/5 dark:has-[:checked]:bg-amber-500/10 transition-all">
            <input type="radio" name="inquiry_type" value="general_support" class="sr-only" />
            <span class="flex items-center justify-between mb-2">
              <svg class="w-6 h-6 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
              <span class="w-4 h-4 rounded-full border-2 border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 flex items-center justify-center text-white">
                <span class="w-2 h-2 rounded-full bg-amber-500 opacity-0 [label:has(:checked)_&]:opacity-100"></span>
              </span>
            </span>
            <span class="text-sm font-bold text-slate-900 dark:text-white">General / Training</span>
            <span class="text-xs text-slate-500 dark:text-slate-400 mt-1">Inquiries & partnerships</span>
          </label>

        </div>
      </div>

      <!-- 2. Target Services (Multi-select) -->
      <div>
        <label class="block text-sm font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider mb-2">
          2. Relevant Services <span class="text-xs font-normal text-slate-500 lowercase">(select all that apply)</span>
        </label>
        
        <div class="flex flex-wrap gap-2.5 pt-2">
          
          <label class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-700 dark:text-slate-300 text-sm font-medium cursor-pointer hover:border-amber-500/50 has-[:checked]:bg-amber-500 has-[:checked]:text-slate-950 has-[:checked]:border-amber-500 transition-all select-none">
            <input type="checkbox" name="services[]" value="IT Consultancy Services" class="sr-only" />
            <svg class="w-4 h-4 hidden [label:has(:checked)_&]:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            IT Consultancy Services
          </label>

          <label class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-700 dark:text-slate-300 text-sm font-medium cursor-pointer hover:border-amber-500/50 has-[:checked]:bg-amber-500 has-[:checked]:text-slate-950 has-[:checked]:border-amber-500 transition-all select-none">
            <input type="checkbox" name="services[]" value="Software Design & Dev" class="sr-only" />
            <svg class="w-4 h-4 hidden [label:has(:checked)_&]:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Software Design & Dev
          </label>

          <label class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-700 dark:text-slate-300 text-sm font-medium cursor-pointer hover:border-amber-500/50 has-[:checked]:bg-amber-500 has-[:checked]:text-slate-950 has-[:checked]:border-amber-500 transition-all select-none">
            <input type="checkbox" name="services[]" value="CCTV & Security Installs" class="sr-only" />
            <svg class="w-4 h-4 hidden [label:has(:checked)_&]:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            CCTV & Security Installs
          </label>

          <label class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-700 dark:text-slate-300 text-sm font-medium cursor-pointer hover:border-amber-500/50 has-[:checked]:bg-amber-500 has-[:checked]:text-slate-950 has-[:checked]:border-amber-500 transition-all select-none">
            <input type="checkbox" name="services[]" value="Corporate System Mgmt" class="sr-only" />
            <svg class="w-4 h-4 hidden [label:has(:checked)_&]:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Corporate System Mgmt
          </label>

          <label class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-slate-700 dark:text-slate-300 text-sm font-medium cursor-pointer hover:border-amber-500/50 has-[:checked]:bg-amber-500 has-[:checked]:text-slate-950 has-[:checked]:border-amber-500 transition-all select-none">
            <input type="checkbox" name="services[]" value="Technical Training" class="sr-only" />
            <svg class="w-4 h-4 hidden [label:has(:checked)_&]:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            Technical Training
          </label>

        </div>
      </div>

      <!-- 3. Contact Details Grid -->
      <div>
        <label class="block text-sm font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider mb-4">
          3. Contact Information
        </label>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Full Name -->
          <div>
            <label for="full_name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Full Name <span class="text-amber-500">*</span>
            </label>
            <input type="text" id="full_name" name="full_name" required placeholder="e.g. John Doe" 
              class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent text-sm transition-all" />
          </div>

          <!-- Email Address -->
          <div>
            <label for="email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Work Email <span class="text-amber-500">*</span>
            </label>
            <input type="email" id="email" name="email" required placeholder="john@company.com" 
              class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent text-sm transition-all" />
          </div>

          <!-- Phone Number -->
          <div>
            <label for="phone" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Phone Number <span class="text-amber-500">*</span>
            </label>
            <input type="tel" id="phone" name="phone" required placeholder="+234 800 000 0000" 
              class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent text-sm transition-all" />
          </div>

          <!-- Organization / Company Name -->
          <div>
            <label for="company" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Company / Organization Name
            </label>
            <input type="text" id="company" name="company" placeholder="e.g. Acme Corp Ltd" 
              class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent text-sm transition-all" />
          </div>

        </div>
      </div>

      <!-- 4. Project Details & Budget Scope -->
      <div class="space-y-4">
        <label class="block text-sm font-bold text-slate-900 dark:text-slate-200 uppercase tracking-wider">
          4. Scope & Message
        </label>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Expected Timeline -->
          <div>
            <label for="timeline" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Estimated Timeline
            </label>
            <select id="timeline" name="timeline" class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm transition-all">
              <option value="immediate">Immediate (&lt; 2 weeks)</option>
              <option value="1_month" selected>1 Month</option>
              <option value="quarter">1 - 3 Months</option>
              <option value="planning">Exploratory / Planning Stage</option>
            </select>
          </div>

          <!-- Estimated Budget -->
          <div>
            <label for="budget" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Estimated Budget Range
            </label>
            <select id="budget" name="budget" class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm transition-all">
              <option value="under_1m">Under ₦1,000,000</option>
              <option value="1m_5m">₦1,000,000 – ₦5,000,000</option>
              <option value="5m_15m">₦5,000,000 – ₦15,000,000</option>
              <option value="15m_plus">₦15,000,000+</option>
              <option value="undisclosed">Not sure / To be discussed</option>
            </select>
          </div>
        </div>

        <!-- Detailed Message -->
        <div>
          <label for="message" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
            Project Overview or Specific Audit Requirements <span class="text-amber-500">*</span>
          </label>
          <textarea id="message" name="message" rows="4" required placeholder="Describe your current setup, challenges, or specific goals (e.g., number of camera channels, multi-office network setup, custom web software needs)..." 
            class="w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent text-sm transition-all"></textarea>
        </div>

        <!-- Optional File Attachment (RFP, Architectural Drawing, Site Specs) -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
            Attach RFP or Site Layout (Optional)
          </label>
          <div class="flex items-center justify-center w-full">
            <label for="attachment" class="flex flex-col items-center justify-center w-full h-28 border-2 border-dashed border-slate-300 dark:border-slate-800 rounded-xl cursor-pointer bg-slate-50 dark:bg-slate-950 hover:bg-slate-100 dark:hover:bg-slate-900/50 transition-all">
              <div class="flex flex-col items-center justify-center pt-5 pb-6">
                <svg class="w-8 h-8 mb-2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>
                <p class="text-xs text-slate-600 dark:text-slate-400"><span class="font-bold text-amber-500">Click to upload</span> or drag and drop</p>
                <p class="text-[10px] text-slate-400 mt-0.5">PDF, DOCX, PNG, JPG or CAD up to 10MB</p>
              </div>
              <input id="attachment" name="attachment" type="file" class="hidden" />
            </label>
          </div>
        </div>
      </div>

      <!-- Submit Action -->
      <div class="pt-4 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-slate-500 dark:text-slate-400 text-center sm:text-left">
          🔒 Your information is secure and protected by our <a href="/privacy" class="underline hover:text-amber-500">Privacy Policy</a>.
        </p>

        <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-base transition-all shadow-lg shadow-amber-500/25 hover:shadow-amber-500/40 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 cursor-pointer">
          <span>Submit Request</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </button>
      </div>

    </form>
  </div>
</div>
