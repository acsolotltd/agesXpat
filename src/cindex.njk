<!-- =========================================
     HERO SECTION
========================================== -->
<section class="relative isolate overflow-hidden bg-slate-950 pt-24 sm:pt-32 pb-20">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-900/40 via-slate-950 to-slate-950" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8 text-center">
    <span class="inline-flex items-center rounded-full bg-amber-500/10 px-4 py-1.5 text-sm font-semibold text-amber-500 ring-1 ring-inset ring-amber-500/30 mb-8 uppercase tracking-wider">
      Empowering Enterprises Since 2009
    </span>
    <h1 class="mx-auto max-w-4xl text-4xl font-extrabold tracking-tight text-white sm:text-6xl">
      Secure, Scalable Infrastructure & <span class="text-amber-500">AI-Powered</span> Software
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-300">
      We bridge the gap between physical hardware and modern code. From enterprise-grade IT networks and physical security to custom web applications and AI automation.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/contact" class="rounded bg-amber-500 px-8 py-4 text-sm font-bold text-slate-900 shadow-lg transition-all hover:-translate-y-1 hover:bg-amber-400">
        Request a Consultation
      </a>
      <a href="#services" class="rounded border border-white/20 bg-white/5 px-8 py-4 text-sm font-bold text-white transition-all hover:bg-white/10">
        Explore Services <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<!-- =========================================
     TECHNOLOGY PARTNERS
========================================== -->
<section class="border-y border-slate-200 bg-slate-50 py-10 dark:border-white/5 dark:bg-slate-900/50">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8 text-center">
    <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-8">Deploying Enterprise-Grade Hardware & Software</p>
    <div class="flex flex-wrap items-center justify-center gap-10 opacity-70 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0 sm:gap-16 lg:gap-24">
      <div class="text-2xl font-black tracking-tighter text-slate-800 dark:text-white">CISCO</div>
      <div class="text-2xl font-black tracking-wide text-red-600 dark:text-red-500">HIKVISION</div>
      <div class="flex items-center gap-1 text-2xl font-bold text-slate-800 dark:text-white">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 22h20L12 2zm0 6l5.5 11h-11L12 8z"/></svg> STARLINK
      </div>
      <div class="text-2xl font-bold italic tracking-tight text-blue-600 dark:text-blue-400">ZKTeco</div>
      <div class="text-2xl font-black text-slate-800 dark:text-white">DSE<span class="text-sm font-normal text-slate-500">®</span></div>
    </div>
  </div>
</section>

<!-- =========================================
     ABOUT US (Legacy & Mission)
========================================== -->
<section class="relative isolate overflow-hidden bg-white py-24 sm:py-32 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-y-16 lg:grid-cols-2 lg:gap-x-16 lg:items-center">
      <div>
        <span class="text-xs font-bold uppercase tracking-[0.25em] text-amber-600 dark:text-amber-500">Our Legacy</span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          Engineering the future of African enterprises since 2009.
        </h2>
        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Ages Xpat Technologies is a premier Nigeria-based IT consulting and software development company. For over a decade, we have been the trusted technical backbone for facilities, farms, and corporate institutions.
        </p>
        <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-400">
          By delivering secure, scalable digital solutions, AI-powered systems, custom software, and rigorous technical training, we provide the end-to-end technology ecosystems that help businesses scale with absolute confidence.
        </p>
      </div>
      
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Feature 1 -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900">
          <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-amber-500/20 text-amber-600 dark:text-amber-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white">Custom Software & AI</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Next-generation web applications, automated reporting, and AI-powered systems.</p>
        </div>
        <!-- Feature 2 (Fixed cut-off code) -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900">
          <div class="h-10 w-10 flex items-center justify-center rounded-lg bg-amber-500/20 text-amber-600 dark:text-amber-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2z" /></svg>
          </div>
          <h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white">Enterprise Infrastructure</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Secure networking hardware, servers, telecom equipment, and managed IT services.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================
     OUR SERVICES GRID
========================================== -->
<section id="services" class="py-24 bg-slate-50 dark:bg-slate-900">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4">Comprehensive Technology Solutions</h2>
      <p class="text-slate-600 dark:text-slate-400">From hardware procurement to AI integrations, we provide end-to-end digital and physical infrastructure.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% set services = [
        { title: "IT Consulting & Project Dev", desc: "Strategic technology planning, network architecture, and turnkey project development." },
        { title: "Web Design & Development", desc: "Custom corporate websites, robust web applications, and scalable software built with modern frameworks." },
        { title: "AI-Powered Systems", desc: "Intelligent automation, smart data reporting, and custom AI integrations to optimize operations." },
        { title: "CCTV Installation", desc: "Enterprise-grade IP surveillance networks, NVR setups, and AI-driven motion detection." },
        { title: "IT Systems Supplies", desc: "Direct procurement and supply of trusted networking hardware, servers, and telecom equipment." },
        { title: "Educational Robotics", desc: "Hands-on robotics programs for institutions, alongside rigorous technical upskilling for corporate teams." }
      ] %}
      
      {% for service in services %}
      <div class="p-8 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 shadow-sm hover:shadow-lg transition-shadow">
        <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-lg flex items-center justify-center mb-6 font-bold text-xl">
          0{{ loop.index }}
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{{ service.title }}</h3>
        <p class="text-slate-600 dark:text-slate-400 leading-relaxed">{{ service.desc }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

