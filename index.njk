---
layout: "base.njk"
title: "Ages Xpat Technologies | Corporate IT & Software Solutions"
description: "Delivering enterprise IT consultancy, CCTV installation, corporate system management, custom software, and technical training in Nigeria."
---

<!-- =========================================
     HERO SECTION (Animated Entrance)
========================================== -->
<section class="relative isolate overflow-hidden bg-slate-50 dark:bg-slate-950 pt-24 sm:pt-32 pb-20 lg:pb-32 transition-colors duration-300"
         x-data="{ loaded: false }" 
         x-init="setTimeout(() => loaded = true, 100)">
  
  <!-- Themeable Gradient Background -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber-100/50 via-slate-50 to-slate-50 dark:from-indigo-900/40 dark:via-slate-950 dark:to-slate-950 transition-colors duration-500" aria-hidden="true"></div>
  
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="transition-all duration-1000 ease-out transform" :class="loaded ? 'translate-y-0 opacity-100' : 'translate-y-8 opacity-0'">
      <span class="inline-flex items-center rounded-full bg-amber-500/10 px-4 py-1.5 text-sm font-bold text-amber-600 dark:text-amber-500 ring-1 ring-inset ring-amber-500/30 mb-8 uppercase tracking-wider">
        Pioneering Enterprise Tech Since 2009
      </span>
      
      <h1 class="mx-auto max-w-5xl text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-6xl lg:text-7xl mb-6">
        Intelligent Infrastructure & <br class="hidden sm:block" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-500 to-orange-400">Custom Software Systems</span>
      </h1>
      
      <p class="mx-auto max-w-2xl text-lg sm:text-xl leading-8 text-slate-600 dark:text-slate-300 mb-10">
        We architect, secure, and manage the digital and physical backbone of modern businesses. From corporate system management to bespoke software design.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="w-full sm:w-auto rounded-lg bg-amber-500 px-8 py-4 text-base font-bold text-slate-900 shadow-xl shadow-amber-500/20 transition-all hover:-translate-y-1 hover:bg-amber-400 active:scale-95">
          Consult an Expert
        </a>
        <a href="#services" class="w-full sm:w-auto rounded-lg border-2 border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50 backdrop-blur-sm px-8 py-4 text-base font-bold text-slate-900 dark:text-white transition-all hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95">
          Explore Solutions
        </a>
      </div>
    </div>
  </div>
</section>

<!-- =========================================
     TECH PARTNERS (Infinite Style Marquee or Grid)
========================================== -->
<section class="border-y border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 py-8 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-6">Powered by Industry Leaders</p>
    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-16 lg:gap-24 opacity-60 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0">
      <div class="text-2xl font-black tracking-tighter text-slate-800 dark:text-white">CISCO</div>
      <div class="text-2xl font-black tracking-wide text-red-600 dark:text-red-500">HIKVISION</div>
      <div class="flex items-center gap-1 text-2xl font-bold text-slate-800 dark:text-white">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 22h20L12 2zm0 6l5.5 11h-11L12 8z"/></svg> STARLINK
      </div>
      <div class="text-2xl font-bold italic tracking-tight text-blue-600 dark:text-blue-400">ZKTeco</div>
    </div>
  </div>
</section>

<!-- =========================================
     OUR SERVICES (Updated to Requested 5 + 1)
========================================== -->
<section id="services" class="py-24 bg-slate-50 dark:bg-slate-950 transition-colors duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16"
         x-data="{ shown: false }" x-init="let ob = new IntersectionObserver(e => { if(e[0].isIntersecting) shown = true }, {threshold: 0.1}); ob.observe($el);">
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white mb-4 transition-all duration-700 transform" :class="shown ? 'translate-y-0 opacity-100' : 'translate-y-8 opacity-0'">
        Core Competencies
      </h2>
      <p class="text-lg text-slate-600 dark:text-slate-400 transition-all duration-700 delay-100 transform" :class="shown ? 'translate-y-0 opacity-100' : 'translate-y-8 opacity-0'">
        We deliver end-to-end solutions, seamlessly integrating physical hardware with custom digital workflows.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
         x-data="{ shown: false }" x-init="let ob = new IntersectionObserver(e => { if(e[0].isIntersecting) shown = true }, {threshold: 0.1}); ob.observe($el);">
      
      {% set services = [
        { 
          title: "IT Consultancy Services", 
          icon: "M13 10V3L4 14h7v7l9-11h-7z",
          desc: "Strategic tech planning, infrastructure audits, and digital transformation roadmaps designed to scale your operations securely." 
        },
        { 
          title: "Software Design & Development", 
          icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
          desc: "Bespoke corporate portals, robust web apps, and automated workflows engineered with modern, scalable software stacks." 
        },
        { 
          title: "Corporate System Management", 
          icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
          desc: "Proactive server administration, network monitoring, troubleshooting, and comprehensive managed IT services for zero downtime." 
        },
        { 
          title: "CCTV Installation & Security", 
          icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
          desc: "Enterprise-grade IP surveillance networks, biometric access control, and AI-driven perimeter security setups." 
        },
        { 
          title: "Corporate Technical Training", 
          icon: "M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z",
          desc: "Intensive upskilling programs. We train your staff on modern software tools, network management, and corporate robotics." 
        },
        { 
          title: "Enterprise Hardware Supply", 
          icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
          desc: "Direct procurement, supply, and configuration of high-end switches, routers, servers, and telecom equipment." 
        }
      ] %}
      
      {% for service in services %}
      <div class="group p-8 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-xl dark:hover:shadow-indigo-900/20 transition-all duration-500 ease-out transform"
           :class="shown ? 'translate-y-0 opacity-100' : 'translate-y-12 opacity-0'" 
           style="transition-delay: {{ loop.index0 * 100 }}ms;">
        <div class="w-14 h-14 bg-amber-100 dark:bg-amber-500/10 text-amber-600 dark:text-amber-500 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="{{ service.icon }}" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{{ service.title }}</h3>
        <p class="text-slate-600 dark:text-slate-400 leading-relaxed">{{ service.desc }}</p>
      </div>
      {% endfor %}
      
    </div>
  </div>
</section>

<!-- =========================================
     IMPACT / STATS (Mobile Optimized Grid)
========================================== -->
<section class="border-y border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 py-16 transition-colors duration-300"
         x-data="{ shown: false }" x-init="let ob = new IntersectionObserver(e => { if(e[0].isIntersecting) shown = true }, {threshold: 0.2}); ob.observe($el);">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div class="transition-all duration-700 transform" :class="shown ? 'scale-100 opacity-100' : 'scale-90 opacity-0'">
        <div class="text-4xl md:text-5xl font-extrabold text-amber-500 mb-2">15+</div>
        <div class="text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wide">Years Active</div>
      </div>
      <div class="transition-all duration-700 delay-100 transform" :class="shown ? 'scale-100 opacity-100' : 'scale-90 opacity-0'">
        <div class="text-4xl md:text-5xl font-extrabold text-amber-500 mb-2">250+</div>
        <div class="text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wide">Projects Deployed</div>
      </div>
      <div class="transition-all duration-700 delay-200 transform" :class="shown ? 'scale-100 opacity-100' : 'scale-90 opacity-0'">
        <div class="text-4xl md:text-5xl font-extrabold text-amber-500 mb-2">99%</div>
        <div class="text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wide">System Uptime</div>
      </div>
      <div class="transition-all duration-700 delay-300 transform" :class="shown ? 'scale-100 opacity-100' : 'scale-90 opacity-0'">
        <div class="text-4xl md:text-5xl font-extrabold text-amber-500 mb-2">24/7</div>
        <div class="text-xs sm:text-sm font-bold text-slate-600 dark:text-slate-400 uppercase tracking-wide">Active Support</div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================
     OUR PROVEN PROCESS (Native Alpine Anim)
========================================== -->
<section class="py-24 bg-slate-50 dark:bg-slate-950 transition-colors duration-300" 
         x-data="{ shown: false }" 
         x-init="let observer = new IntersectionObserver(entries => { if (entries[0].isIntersecting) shown = true; }, { threshold: 0.2 }); observer.observe($el);">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white mb-16">How We Execute</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-12 md:gap-8">
      
      {% set steps = ["Site/System Audit", "Custom Architecture", "Turnkey Deployment", "Training & Management"] %}
      {% for step in steps %}
      <div class="relative transition-all duration-700 ease-out transform"
           :class="shown ? 'translate-y-0 opacity-100' : 'translate-y-16 opacity-0'" 
           style="transition-delay: {{ loop.index0 * 150 }}ms;">
        
        <!-- Animated connecting line for desktop -->
        {% if not loop.last %}
        <div class="hidden md:block absolute top-8 left-[60%] w-full h-[2px] bg-slate-200 dark:bg-slate-800 -z-10 overflow-hidden">
           <div class="h-full bg-amber-500 transition-all duration-1000 ease-in-out" 
                :class="shown ? 'w-full' : 'w-0'" 
                style="transition-delay: {{ (loop.index0 * 150) + 300 }}ms;"></div>
        </div>
        {% endif %}

        <div class="w-16 h-16 mx-auto bg-amber-500 text-slate-900 font-extrabold text-2xl rounded-full flex items-center justify-center mb-6 shadow-lg shadow-amber-500/30 ring-8 ring-slate-50 dark:ring-slate-950">
          {{ loop.index }}
        </div>
        <h3 class="font-bold text-lg text-slate-900 dark:text-white">{{ step }}</h3>
      </div>
      {% endfor %}

    </div>
  </div>
</section>

<!-- =========================================
     FINAL CALL TO ACTION
========================================== -->
<section class="relative bg-indigo-950 py-24 text-center overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"></div>
  
  <div class="relative mx-auto max-w-4xl px-4 sm:px-6 z-10"
       x-data="{ shown: false }" x-init="let ob = new IntersectionObserver(e => { if(e[0].isIntersecting) shown = true }, {threshold: 0.3}); ob.observe($el);">
    
    <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6 transition-all duration-700 transform" :class="shown ? 'translate-y-0 opacity-100' : 'translate-y-8 opacity-0'">
      Ready to upgrade your enterprise?
    </h2>
    
    <p class="text-indigo-200 text-lg md:text-xl mb-10 max-w-2xl mx-auto transition-all duration-700 delay-100 transform" :class="shown ? 'translate-y-0 opacity-100' : 'translate-y-8 opacity-0'">
      Schedule a technical audit, request custom software specifications, or speak directly with our engineering team today.
    </p>
    
    <div class="transition-all duration-700 delay-200 transform" :class="shown ? 'scale-100 opacity-100' : 'scale-90 opacity-0'">
      <a href="/contact" class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-10 py-5 bg-amber-500 text-slate-900 font-bold text-lg rounded-xl shadow-2xl hover:bg-amber-400 hover:shadow-amber-500/20 hover:-translate-y-1 transition-all active:scale-95">
        Get a Custom Quote
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </div>
  </div>
</section>
